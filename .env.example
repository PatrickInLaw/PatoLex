# PatoLex environment variables — copy to .env.local and fill in real values.
# NEVER commit .env.local.

# PostgreSQL direct connection URL (port 5432).
# Use this URL for the C# pipeline and drizzle-kit migrate.
# For Vercel serverless functions use the PgBouncer URL (port 6543) instead.
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://postgres:password@localhost:5432/patolex
